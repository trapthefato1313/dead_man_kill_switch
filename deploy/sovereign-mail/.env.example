# Copia para .env e preenche. NUNCA faças commit do .env.

# Dominio raiz que possuis (a reputacao vive aqui)
DOMINIO=SEUDOMINIO.COM
# Subdominio de envio das campanhas
NEWS_HOST=news.${DOMINIO}
# Hostnames e IPs dos 3 nos
NODE1_HOSTNAME=mx.${DOMINIO}
NODE2_HOSTNAME=mx2.${DOMINIO}
NODE3_HOSTNAME=mx3.${DOMINIO}
IP_NODE1=IP_DO_NO_1
IP_NODE2=IP_DO_NO_2
IP_NODE3=IP_DO_NO_3

# Selector DKIM unico por no
DKIM_SEL1=sel1
DKIM_SEL2=sel2
DKIM_SEL3=sel3

# Credencial de bootstrap/recovery do Stalwart (formato admin:PASSWORD).
# Usada para o wizard de setup em http://IP_DO_NO:8080/admin. REMOVE do .env e do
# compose depois de criares o administrador definitivo em cada no.
STALWART_RECOVERY_ADMIN=admin:TROQUE_ESTA_SENHA

# Listmonk (VPS 0)
LISTMONK_DB_PASSWORD=TROQUE_ESTA_SENHA_FORTE
LISTMONK_ADMIN_PASSWORD=TROQUE_NO_PRIMEIRO_ACESSO
LISTMONK_SMTP_USER=news@${DOMINIO}
LISTMONK_SMTP_PASS=senha-da-conta-stalwart

# Caixa/imagem de bounce (IMAP do Stalwart)
BOUNCE_MAILBOX=bounce@${DOMINIO}

# --- Dead man's switch: usa os 3 nos Stalwart como relay (failover) ---
# Ficheiro de dados do switch
DMKS_DATA=/var/lib/dmks
# Remetente do switch (tem de ser do dominio de envio, para o DKIM/SPF baterem)
SWITCH_FROM=switch@${NEWS_HOST}
# Conta SMTP criada no Stalwart, usada pelo switch para autenticar nos nos
SWITCH_SMTP_USER=relay@${DOMINIO}
# Nao guardes a senha aqui: exporta-a no servico (env:SWITCH_SMTP_PASS)
SWITCH_SMTP_PASS_CHANGEME=nao-uses-esta
# Onde o dono recebe os avisos do switch
OWNER_EMAIL=dono@${DOMINIO}

